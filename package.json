{
  "name": "n8n-nodes-netbox-connector",
  "version": "0.1.1",
  "description": "n8n community node for the NetBox REST and GraphQL APIs",
  "keywords": [
    "n8n-community-node-package",
    "n8n",
    "netbox",
    "ipam",
    "dcim"
  ],
  "license": "MIT",
  "homepage": "https://github.com/eduardez/n8n-nodes-netbox-connector#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eduardez/n8n-nodes-netbox-connector.git"
  },
  "bugs": {
    "url": "https://github.com/eduardez/n8n-nodes-netbox-connector/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "author": {
    "name": "eduardez"
  },
  "engines": {
    "node": ">=20.15"
  },
  "main": "index.js",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "index.js"
  ],
  "scripts": {
    "build": "rimraf dist && tsc && gulp build:icons",
    "dev": "tsc --watch",
    "lint": "eslint credentials nodes package.json",
    "test": "npm run build && node --test test/*.test.js",
    "test:integration": "npm run build && node --test test/integration/*.test.js",
    "generate": "node scripts/generate-catalog.mjs",
    "check:coverage": "node scripts/check-coverage.mjs",
    "prepublishOnly": "npm run build && npm run lint"
  },
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/NetBoxApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/NetBoxConnector/NetBoxConnector.node.js"
    ]
  },
  "dependencies": {
    "form-data": "^4.0.4",
    "graphql": "^16.14.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@typescript-eslint/parser": "^8.50.1",
    "conventional-changelog-conventionalcommits": "10.4.1",
    "eslint": "^8.57.0",
    "eslint-plugin-n8n-nodes-base": "^1.16.4",
    "gulp": "^5.0.0",
    "n8n-workflow": "^1.120.3",
    "prettier": "^3.5.3",
    "rimraf": "^6.0.1",
    "semantic-release": "25.0.9",
    "typescript": "^5.8.2"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  },
  "overrides": {
    "@semantic-release/release-notes-generator": {
      "conventional-changelog-writer": "^9.0.0"
    }
  }
}
